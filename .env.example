# ============================================
# DealGuider – Environment Variables
# ============================================
# All VITE_ prefixed variables are client-side (bundled by Vite).
# Server-side variables are set in Supabase Edge Function secrets.

# ---- CLIENT-SIDE (required for frontend) ----
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---- PAYSTACK (payment provider) ----
# Public key is bundled client-side for the Paystack Inline popup.
# The secret key is server-side only (Supabase Edge Function secrets).
VITE_PAYSTACK_PUBLIC_KEY=your-paystack-public-key
